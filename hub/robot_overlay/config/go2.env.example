# Copy to an untracked, mode-600 go2.env only for a manual/legacy install.
# bootstrap_robot0_cleanroom.sh generates the preferred file automatically.
# Never put tokens in this file.
FOCUS_DEPLOY_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/topofocus/robot-0"
FOCUS_CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/topofocus"
TINYNAV_WORKSPACE="$FOCUS_DEPLOY_ROOT/workspaces"
TINYNAV_ROOT="$TINYNAV_WORKSPACE/tinynav"
TINYNAV_PATCHED_ROOT="$TINYNAV_ROOT"
TINYNAV_PERCEPTION_PATCHED_ROOT="$TINYNAV_ROOT"
TINYNAV_PERCEPTION_PATCHED_COMMIT=a6290559b13cedf19c05f7ec64ff91a29b685cbd
TINYNAV_PERCEPTION_PATCHED_SHA256=3a695d5210d60ea1f721549ca7458ba89e7bf32db5178cd1c312c633aef1c3b3
TINYNAV_SETUP="$FOCUS_CONFIG_ROOT/robot-0-setup.bash"
TINYNAV_PYTHON="$TINYNAV_ROOT/.venv/bin/python"

FOCUS_REHEARSAL_SESSION=focus_live_rehearsal
FOCUS_ROBOT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/topofocus"
FOCUS_REALSENSE_POWER_SERVICE=focus-realsense-power.service

# The Hub normally reaches this loopback endpoint through an SSH reverse
# tunnel. Authentication is loaded from a separate chmod-600 token file.
FOCUS_HUB_BASE_URL=http://127.0.0.1:18089
FOCUS_ROBOT_ID=robot-0

# Dedicated Unitree LAN. configure_go2_network.sh consumes these values but
# does not contact the robot or initialize DDS.
UNITREE_NET_IF=eth0
UNITREE_HOST_CIDR=192.168.123.100/24
UNITREE_ROBOT_ADDRESS=192.168.123.161
